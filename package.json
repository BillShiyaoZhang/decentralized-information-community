{
  "name": "information-community",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A portable, ontology-driven community knowledge graph for static sites and private servers.",
  "engines": { "node": ">=24.12.0 <25" },
  "workspaces": ["packages/core", "packages/runtime"],
  "devDependencies": { "typescript": "5.9.3" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "start": "node server/main.mjs",
    "test": "node --test --test-timeout=15000 tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "apply": "node scripts/apply.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "init:server": "node scripts/init-server.mjs",
    "package:core": "node scripts/pack-core.mjs",
    "package:runtime": "node scripts/pack-runtime.mjs"
  }
}
