# Docker Compose reads this file as .env. Plain npm commands read process env only.
# Prefer community.config.json for settings shared by Pages, npm and Docker.
# Optional: override the data source for the Docker build and server startup.
# Paths in Docker must be in this repository/build context (or explicitly mounted).
GRAPH_FILE=
COMMUNITY_CONFIG=community.config.json

# Server writes are disabled until you set a private random token.
WRITE_TOKEN=
BIND_ADDRESS=127.0.0.1
SERVER_PORT=4174
